# Copy to .env only when configuring manually; never commit real values.
OPENAI_API_KEY=""
VERCEL_TOKEN=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Backend only. Optional model; deterministic mode needs no model key.
OPENAI_MODEL="gpt-4.1-mini"
TARVO_API_TOKEN=""
# Human access password, separate from the technical bearer; server only.
TARVO_ACCESS_PASSWORD=""
TARVO_SESSION_TTL_SECONDS="28800"
TARVO_ENV="local"
TARVO_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
# Optional absolute directories for hosted deployment:
# TARVO_PROJECT_ROOT=/app
# TARVO_INPUT_DIR=/app/contexto/data_pack
# TARVO_STATE_DIR=/data
# TARVO_JOB_TIMEOUT_SECONDS=180
# No provider/deployment token belongs in frontend VITE_ variables.
# The app reads inherited environment only; this file is not auto-loaded.
# Persistent documents/blobs/selections/sessions/runs all live under TARVO_STATE_DIR.
